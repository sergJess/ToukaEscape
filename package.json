{
    "name": "toukaescape",
    "version": "1.0.0",
    "description": "2d game",
    "main": "index.js",
    "config": {
        "dev": "--config webpack/dev.config.js",
        "prod": "--config webpack/prod.config.js"
    },
    "scripts": {
        "webpack-config-dev": "nodemon --watch \"./webpack/*\" --exec npm run start-dev",
        "webpack-config-prod": "nodemon --watch \"./webpack/*\" --exec npm run start-prod",
        "start-dev": "cross-env-shell webpack serve ${npm_package_config_dev}",
        "start-prod": "cross-env-shell webpack serve ${npm_package_config_prod}",
        "build-dev": "cross-env-shell webpack ${npm_package_config_dev}",
        "build-prod": "cross-env-shell webpack ${npm_package_config_prod} --stats-children",
        "clean": "rd /s /q build",
        "lint": "eslint src --ext .js --ext .ts",
        "lint-fix": "eslint src --ext .js --ext .ts --fix",
        "test": "cross-env jest --config jest/jest.config.js",
        "test-watch": "jest --watch --config jest/jest.config.js",
        "test-coverage": "jest --coverage --config jest/jest.config.js"
    },
    "keywords": [
        "web",
        "game",
        "2d"
    ],
    "author": "Serg Jess",
    "license": "ISC",
    "devDependencies": {
        "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
        "@types/react": "^19.0.8",
        "babel-loader": "^9.2.1",
        "cross-env": "^7.0.3",
        "eslint": "^9.19.0",
        "filemanager-webpack-plugin": "^8.0.0",
        "html-loader": "^5.1.0",
        "html-webpack-plugin": "^5.6.3",
        "image-minimizer-webpack-plugin": "^4.1.3",
        "imagemin": "^9.0.0",
        "imagemin-gifsicle": "^7.0.0",
        "imagemin-jpegtran": "^8.0.0",
        "imagemin-optipng": "^8.0.0",
        "imagemin-svgo": "^11.0.1",
        "jest": "^29.7.0",
        "mini-css-extract-plugin": "^2.9.2",
        "nodemon": "^3.1.9",
        "sass": "^1.83.4",
        "sass-loader": "^16.0.4",
        "style-loader": "^4.0.0",
        "terser-webpack-plugin": "^5.3.11",
        "ts-loader": "^9.5.2",
        "typescript": "^5.7.3",
        "webpack": "^5.97.1",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.0"
    },
    "dependencies": {
        "mobx": "^6.13.6",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-refresh": "^0.16.0",
        "react-router-dom": "^7.1.5",
        "resolve-url-loader": "^5.0.0",
        "sass-embedded": "^1.83.4"
    }
}
